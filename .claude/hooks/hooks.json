{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/guard_branch.py\"",
            "timeout": 5,
            "statusMessage": "檢查分支保護"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/guard_branch.py\"",
            "timeout": 5,
            "statusMessage": "檢查分支保護"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/check_router.py\"",
            "timeout": 10,
            "statusMessage": "檢查 Router 一致性"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/guard_critical.py\"",
            "timeout": 5,
            "statusMessage": "檢查 backup tag"
          }
        ]
      }
    ]
  }
}
