{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/secrets/**)",
      "Read(/**/secrets/**)",
      "Read(/credentials/**)",
      "Read(/**/credentials/**)",
      "Read(/**/id_rsa)",
      "Read(/**/id_ed25519)",
      "Read(/**/.aws/credentials)",
      "Read(/**/.ssh/**)",
      "Read(/config/credentials.json)",
      "Read(/**/config/credentials.json)",
      "Read(/.claude/settings.local.json)",
      "Edit(/.env)",
      "Edit(/.env.*)",
      "Edit(/**/.env)",
      "Edit(/**/.env.*)",
      "Edit(/secrets/**)",
      "Edit(/**/secrets/**)",
      "Edit(/credentials/**)",
      "Edit(/**/credentials/**)",
      "Edit(/**/.ssh/**)",
      "Edit(/config/credentials.json)",
      "Edit(/**/config/credentials.json)",
      "Edit(/.claude/settings.local.json)"
    ]
  }
}
