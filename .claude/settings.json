{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/secrets/**)",
      "Read(/**/secrets/**)",
      "Read(/credentials/**)",
      "Read(/**/credentials/**)",
      "Read(/**/id_rsa)",
      "Read(/**/id_ed25519)",
      "Read(/**/.aws/credentials)",
      "Read(/**/.ssh/**)",
      "Read(/config/credentials.json)",
      "Read(/**/config/credentials.json)",
      "Read(/.claude/settings.local.json)",
      "Edit(/.env)",
      "Edit(/.env.*)",
      "Edit(/**/.env)",
      "Edit(/**/.env.*)",
      "Edit(/secrets/**)",
      "Edit(/**/secrets/**)",
      "Edit(/credentials/**)",
      "Edit(/**/credentials/**)",
      "Edit(/**/.ssh/**)",
      "Edit(/config/credentials.json)",
      "Edit(/**/config/credentials.json)",
      "Edit(/.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-branch.sh\"",
            "timeout": 5,
            "statusMessage": "檢查分支保護"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-branch.sh\"",
            "timeout": 5,
            "statusMessage": "檢查分支保護"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-router.sh\"",
            "timeout": 10,
            "statusMessage": "檢查 Router 一致性"
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-memory.sh\"",
            "timeout": 10,
            "statusMessage": "檢查記憶層准入"
          },
          {
            "type": "command",
            "if": "Bash(git *)",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-critical.sh\"",
            "timeout": 5,
            "statusMessage": "檢查 backup tag"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-done.sh\"",
            "timeout": 15,
            "statusMessage": "結束前自檢"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/checkpoint.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/recall-lessons.sh\"",
            "timeout": 5,
            "statusMessage": "召回領悟帳本"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/checkpoint.sh\"",
            "timeout": 20,
            "statusMessage": "檢查斷點"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/checkpoint.sh\"",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/checkpoint.sh\"",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/checkpoint.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/checkpoint.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
